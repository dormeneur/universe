# Copy to .env.local and fill in. Never commit real values.

NODE_ENV=development
LOG_LEVEL=debug

# Postgres connection string.
# Local: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:17
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uniiverse

# Separate database used by `npm run test:integration`. It is dropped and
# recreated freely, so it must never point at anything you care about.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uniiverse_test

# Institutional domains that grant immediate access. Comma-separated; entries
# may be exact (college.ac.in) or suffix wildcards (*.ac.in). Anything outside
# the list goes to manual review rather than being rejected.
CAMPUS_EMAIL_DOMAINS=college.ac.in,*.college.ac.in

# Email delivery. Without RESEND_API_KEY, sign-in codes are logged instead of
# sent — which must be opted into explicitly so a misconfigured deploy fails
# loudly rather than writing every account's code to the log.
# RESEND_API_KEY=re_...
# RESEND_FROM=Uni-verse <noreply@your-domain>
ALLOW_CONSOLE_MAIL=true
DEV_MAIL_SINK=/tmp/uniiverse-mail.jsonl
